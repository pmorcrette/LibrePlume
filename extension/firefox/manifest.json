{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "LibrePlume",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "fr",
  "homepage_url": "https://github.com/pmorcrette/LibrePlume",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "libreplume@libreplume.org",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "LibrePlume",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "check-field": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_commandCheck__"
    }
  }
}
